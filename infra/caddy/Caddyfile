# No-domain setup for the tarsha VM (external IP 34.30.155.166).
# api.34-30-155-166.sslip.io resolves to that IP automatically via sslip.io
# (no DNS to configure) and Caddy gets a real Let's Encrypt cert for it.
# Swap to a real domain later if you get one.
api.34-30-155-166.sslip.io {
	reverse_proxy backend:8081

	header {
		# Remove server identification
		-Server
		# Security headers
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format json
	}
}
