# No-domain setup. Replace REPLACE_WITH_VM_IP below with your VM's external
# IP, keeping the dots, e.g. IP 203.0.113.10  ->  api.203.0.113.10.sslip.io
# sslip.io resolves that name to your VM automatically (no DNS to configure)
# and Caddy gets a real Let's Encrypt cert for it. Then: restart caddy.
# Swap to a real domain later if you get one.
api.REPLACE_WITH_VM_IP.sslip.io {
	reverse_proxy backend:8081

	header {
		# Remove server identification
		-Server
		# Security headers
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format json
	}
}
