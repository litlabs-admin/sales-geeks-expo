# Copy to .env.worker on the VM and fill in all values
# NEVER commit the real .env.worker file

NODE_ENV=production

# Supabase (production project)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Redis (Docker internal — do not change)
REDIS_URL=redis://redis:6379

# Resend (for notification fanout)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
