# Copy to .env.backend on the VM and fill in all values
# NEVER commit the real .env.backend file

NODE_ENV=production

# Supabase (production project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Redis (Docker internal — do not change)
REDIS_URL=redis://redis:6379

# CORS — the Vercel frontend URL (no domain: use the *.vercel.app URL Vercel assigns)
CORS_ALLOWED_ORIGINS=https://tarsha-expo.vercel.app

# QR signing — generate with: openssl rand -hex 32
# MUST be identical across all backend redeploys
QR_SIGNING_SECRET=GENERATE_WITH_OPENSSL

# Calendly webhook secret — generate with: openssl rand -hex 32
CALENDLY_WEBHOOK_SECRET=GENERATE_WITH_OPENSSL

# Resend (email) — no verified domain yet: onboarding@resend.dev only
# delivers to the Resend account owner's email. Swap to noreply@<domain> later.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
